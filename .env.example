# --- LLM Sağlayıcı Ayarları ---
LLM_PRIMARY_PROVIDER=deepseek          # deepseek | anthropic | openai | openrouter | gemini | groq | mistral | ollama
LLM_FALLBACK_PROVIDER=anthropic
LLM_TIMEOUT=60                          # LLM istek zaman aşımı (saniye)
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- İşletme Keşif Ayarları ---
DISCOVERY_PRIMARY_PROVIDER=osm         # osm | google_places
GOOGLE_PLACES_API_KEY=
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_CX=

# --- Instagram (API'siz Sifir Key Modu Varsayilendir. Opsiyonel API'ler:) ---
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
INSTAGRAM_SESSION_ENCRYPTION_KEY=      # Fernet.generate_key() ile uret
HIKERAPI_API_KEY=                      # HikerAPI (100 ucretsiz istek - hikerapi.com)
APIFY_API_KEY=                         # Apify Instagram Scraper ($5/ay ucretsiz kredi - apify.com)
INSTAGRAM_GRAPH_API_TOKEN=             # Meta Resmi Graph API Token (developers.facebook.com)
INSTAGRAM_BUSINESS_ACCOUNT_ID=         # Meta Graph API Business Account ID
CREATORCRAWL_API_KEY=                  # CreatorCrawl (50 ucretsiz kredi)
APIDIRECT_API_KEY=                     # API Direct (50 ucretsiz istek)

# --- Bildirimler ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_EMAIL_SMTP_HOST=
NOTIFY_EMAIL_SMTP_PORT=587
NOTIFY_EMAIL_USERNAME=
NOTIFY_EMAIL_PASSWORD=
NOTIFY_EMAIL_RECIPIENT=                 # Bildirimlerin gönderileceği e-posta adresi

# --- Genel Ayarlar ---
OUTREACH_MODE=assisted                 # assisted | full_auto
MAX_DAILY_OUTREACH=15
AEGIS_DATABASE_URL=                    # Özel veritabanı yolu (örn. sqlite:///data/custom.db)
AEGIS_FERNET_KEY=                      # Şifreleme anahtarı
AEGIS_CONTACT_EMAIL=                   # OSM UA başlığında kullanılan e-posta adresi
AEGISSCout_LOGS_DIR=                   # Özel log dizini
NOTIFY_SMTP_TIMEOUT=15                 # SMTP zaman aşımı (saniye)

